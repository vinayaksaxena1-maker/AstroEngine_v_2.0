{
  "name": "sanatan-astro-engine",
  "version": "1.0.0",
  "description": "High-precision Vedic Panchang, Astronomical and Hindu Festival Calculation Engine powered by Proprietary MIT/JPL Sanatan Engine",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build:types": "tsc --emitDeclarationOnly",
    "build:bundle": "esbuild src/index.ts --bundle --platform=neutral --format=esm --outfile=dist/index.js",
    "build": "npm run build:types && npm run build:bundle",
    "test": "node tests/test.mjs",
    "baseline:generate": "node scripts/generate_baseline.mjs",
    "audit:feasibility": "node scripts/audit_feasibility.mjs",
    "audit:phase2": "node tests/audit_phase2_positions.mjs",
    "audit:phase3": "node tests/audit_phase3_riseset_bhavas.mjs",
    "audit:phase4": "node tests/audit_phase4_panchang.mjs",
    "audit:phase6": "node tests/audit_phase6_stress.mjs",
    "audit:kundli": "node tests/audit_module1_charts.mjs",
    "audit:vargas": "node tests/audit_module2_vargas.mjs",
    "audit:shadbala": "node tests/audit_module3_shadbala.mjs",
    "audit:ashtakavarga": "node tests/audit_module4_ashtakavarga.mjs",
    "audit:dashas": "node tests/audit_module5_dashas.mjs",
    "audit:predictive": "node tests/audit_module6_advanced.mjs",
    "audit:stress": "node tests/audit_final_stress_suite.mjs",
    "audit:all": "npm run audit:kundli && npm run audit:vargas && npm run audit:shadbala && npm run audit:ashtakavarga && npm run audit:dashas && npm run audit:predictive && npm run audit:stress"
  },
  "keywords": [
    "panchang",
    "vedic-astrology",
    "hindu-calendar",
    "tithi",
    "nakshatra",
    "chaughadiya",
    "muhurat",
    "festivals",
    "astronomy",
    "jpl",
    "drik-panchang"
  ],
  "author": "Vinayak Saxena",
  "license": "UNLICENSED",
  "dependencies": {
    "astronomy-engine": "^2.1.19"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "^5.8.2"
  }
}
